{
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "*_test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  // add environment variable TEST=OK to the test
  "python.envFile": "${workspaceFolder}/.env",
  // custom config for python
  "[python]": {
    // format the code on save
    "editor.formatOnSave": true,
    // actions run on save
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    // remove trailling whitespace on save
    "files.trimTrailingWhitespace": true,
    "editor.defaultFormatter": "ms-python.autopep8",
  },

  // python formatting (indentation)
  "autopep8.path": ["/usr/local/bin/autopep8"],
  "autopep8.args": ["--max-line-length", "120", "--experimental"],

  // activate pylint
  "pylint.path": ["/usr/local/bin/pylint"],
  "pylint.args":["--rcfile=${workspaceFolder}/.pylintrc"],

}