# File to describe the pylint rules

[MASTER]
# use to import gws_core into pylint so pylint is awaire or gws_core even if it is 
# not a pip package
init-hook='import sys; sys.path.append("/lab/user/bricks/.lib/gws_core/src"); sys.path.append("/lab/user/bricks/gws_core/src")'
disable=
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,

    no-else-raise,
    no-else-return,

    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-public-methods,
    too-few-public-methods,

    bare-except,
    raise-missing-from

# White list pydantic to prevent warnings on imports 
# https://github.com/samuelcolvin/pydantic/issues/1961#issuecomment-759522422
extension-pkg-whitelist=pydantic


[FORMAT]
max-line-length=200