# SSH Server Configuration
# File to configure the ssh server so it is possible to connect to the container
# with SSH and use it with VS Code Remote
Port 2222
ListenAddress 0.0.0.0

# Logging
SyslogFacility AUTH
LogLevel INFO
# Additional logging for debugging authentication issues
# Use VERBOSE for detailed logs, DEBUG for even more detail, or INFO for standard logging

# Authentication - Only allow labuser to login
PermitRootLogin no
AllowUsers labuser
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# TCP Forwarding - Essential for VS Code Remote
AllowTcpForwarding yes
X11Forwarding no

# Various settings
Subsystem sftp internal-sftp
UseDNS no
PrintMotd no

# Don't accept all client environment variables (security risk)
# Only accept locale settings
AcceptEnv LANG LC_*

# Required for proper interactive sessions with VS Code
PermitTTY yes

# Keep connections alive
ClientAliveInterval 60
ClientAliveCountMax 10

# Permit the server to listen for VS Code's port forwarding
# clientspecified allows client to specify bind address for forwarded ports
GatewayPorts clientspecified
PermitTunnel yes